# ═══════════════════════════════════════════════════════════════════════
#  DELETE THIS FILE BEFORE MERGING TO main.
# ═══════════════════════════════════════════════════════════════════════
#
# Branch-scoped opt-in for the placeholder-content pass (August 2026).
# It exists so the Vercel PREVIEW build of this branch completes and gives
# a shareable URL for judging layout while the placeholder copy is still in
# the tree. It is committed — unlike .env / .env.local, which .gitignore
# excludes — precisely so it travels with the branch and shows up in a diff.
#
# It does NOT open a path to production:
#   - scripts/check-no-placeholders.mjs hard-fails whenever
#     VERCEL_ENV === "production", opt-in or not. chrispollard.com.au cannot
#     be built while {{FAKE: markers are present.
#   - PLACEHOLDER_MODE also forces noindex/nofollow on the deployed page, so
#     the fabricated copy is not crawlable while it is up.
#
# No secrets belong in this file. It is public in the repository.

# Renders the fixed warning banner, the visible fact-slot labels and the
# ?hero=1|2|3 switcher on the deployed preview.
NEXT_PUBLIC_PLACEHOLDER_MODE=true

# Downgrades the placeholder guard from "fail the build" to "warn loudly",
# on non-production builds only.
ALLOW_PLACEHOLDER_BUILD=true
