{
  "name": "chris-pollard-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Recruiter-facing portfolio for Chris Pollard with a live, grounded agent.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "embed": "tsx scripts/embed-corpus.ts",
    "eval": "tsx scripts/eval.ts",
    "smoke": "tsx scripts/smoke-agent.ts",
    "record-stream": "tsx scripts/record-stream.ts > scripts/fixtures/stream.sse",
    "ui:checks": "node scripts/ui-checks.mjs",
    "ui:replay": "node scripts/ui-replay.mjs",
    "verify": "npm run typecheck && npm run lint && npm run eval && npm run smoke"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.236",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "^1.62.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
