# ─── OpenRouter (chat + embeddings) ───────────────────────────────────
# Single gateway for both the chat agent (Claude Haiku) and embeddings
# (text-embedding-3-small). Create a key at https://openrouter.ai/keys
# and set a credit limit on it — this key fronts a public endpoint.
OPENROUTER_API_KEY=

# ─── Upstash Redis (rate limiting) ────────────────────────────────────
# Public endpoint protection: per-IP + per-session limits.
# Create a database at https://console.upstash.com/ (REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional ─────────────────────────────────────────────────────────
# Deployed site URL. Sent as HTTP-Referer for app attribution on the
# OpenRouter dashboard. Cosmetic — safe to leave blank locally.
SITE_URL=

# ─── Placeholder content pass (TEMPORARY, August 2026) ────────────────
# Set to "true" to render the placeholder-mode scaffolding: the fixed
# "PLACEHOLDER CONTENT — NOT FOR DEPLOY" banner, the visible fact-slot
# labels, and the ?hero=1|2|3 variant switcher.
#
#   NEXT_PUBLIC_PLACEHOLDER_MODE=true npm run dev
#
# It does NOT gate the fabricated copy itself — every fabricated string is
# marked {{FAKE: ...}} in the source, and scripts/check-no-placeholders.mjs
# fails `npm run build` while any of them remain. Delete this variable when
# the real copy lands.
NEXT_PUBLIC_PLACEHOLDER_MODE=

# ─── Notes ────────────────────────────────────────────────────────────
# - Copy this file to .env.local and fill in the values.
# - Never commit .env.local.
# - All keys are server-only; none may reach client code.
# - If any key is missing the app must still render; the agent falls back
#   to a graceful "unavailable" state rather than throwing.
