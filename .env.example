# ─── OpenRouter (chat + embeddings) ───────────────────────────────────
# Single gateway for both the chat agent (Claude Haiku) and embeddings
# (text-embedding-3-small). Create a key at https://openrouter.ai/keys
# and set a credit limit on it — this key fronts a public endpoint.
OPENROUTER_API_KEY=

# ─── Upstash Redis (rate limiting) ────────────────────────────────────
# Public endpoint protection: per-IP + per-session limits.
# Create a database at https://console.upstash.com/ (REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional ─────────────────────────────────────────────────────────
# Deployed site URL. Sent as HTTP-Referer for app attribution on the
# OpenRouter dashboard. Cosmetic — safe to leave blank locally.
SITE_URL=

# ─── Notes ────────────────────────────────────────────────────────────
# - Copy this file to .env.local and fill in the values.
# - Never commit .env.local.
# - All keys are server-only; none may reach client code.
# - If any key is missing the app must still render; the agent falls back
#   to a graceful "unavailable" state rather than throwing.
