# ─── Anthropic (chat agent) ───────────────────────────────────────────
# Used by the ToolLoopAgent for streamed answers. Get one at:
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── OpenAI (embeddings only) ─────────────────────────────────────────
# Used by scripts/embed-corpus.ts and the query-time retriever
# (text-embedding-3-small). Not used for chat.
OPENAI_API_KEY=

# ─── Upstash Redis (rate limiting) ────────────────────────────────────
# Public endpoint protection: per-IP + per-session limits.
# Create a database at https://console.upstash.com/ (REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Notes ────────────────────────────────────────────────────────────
# - Copy this file to .env.local and fill in the values.
# - Never commit .env.local.
# - If any key is missing the app must still render; the agent falls back
#   to a graceful "unavailable" state rather than throwing.
